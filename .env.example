BASE_URL=https://giaidau.fcmobile.garena.vn
# REQUIRED: exact GET detail Request URL path from DevTools, with ID replaced by {event_id}.
# Do not guess this endpoint; see README.
EVENT_DETAIL_ENDPOINT_TEMPLATE=/api/app/event/detail/{event_id}
# UID shown in the logged-in account header:
CURRENT_UID=1042161862093455360
START_ID=7509
END_ID=8670
REQUEST_DELAY_SECONDS=0.2
REQUEST_TIMEOUT_MS=15000
BROWSER_PROFILE_DIR=browser-profile
DATABASE_PATH=data/tournaments.sqlite3
REPORT_DIR=reports

# POST endpoint observed in DevTools; same-origin browser session is used.
REGISTRATION_ENDPOINT=/api/app/event/register
REGISTRATION_DELAY_SECONDS=3
